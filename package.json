{
  "name": "qunitgs2",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.cjs tests/local/*.test.mjs",
    "test:browser": "playwright test",
    "test:all": "npm test && npm run test:browser",
    "test:live": "bash scripts/test-live.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@google/clasp": "3.4.1",
    "@playwright/test": "1.63.0"
  }
}
